# Config específica de cada instalación (contiene la contraseña de la base)
api/config/db.local.php

# Archivos generados en runtime
api/logs/*.log
uploads/*
!uploads/.htaccess
install/backups/

# Archivos de caché generados por librerías (Dompdf, etc.)
vendor/dompdf/dompdf/lib/fonts/*.afm.json
vendor/dompdf/dompdf/lib/fonts/*.ufm.json

# Artefactos del entorno de desarrollo
.impeccable/
pos/.impeccable/
.claude/
.agents/
PRODUCT.md
reglas_de.txt

# Composer installer artifacts (no forman parte del proyecto)
composer.phar
composer-setup.php

# Electron app
electron/node_modules/
electron/dist/
electron/resources/php/
electron/resources/mariadb/
electron/resources/nssm.exe
electron/resources/_tmp/
electron/resources/www/
# Credenciales y secretos para publicar actualizaciones (nunca commitear)
electron/.env.publish
tauri-shell/.env.publish
# upload-handler.php contiene el secreto real — solo vive en Hostinger y localmente
electron/scripts/upload-handler.php
