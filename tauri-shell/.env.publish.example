# Configuración para publicar actualizaciones de Logos POS (Tauri)
# Copiá este archivo a .env.publish y completá los valores reales
# NUNCA commitees .env.publish (está en .gitignore)
#
# Mismas credenciales que electron/.env.publish — el mismo upload-handler.php
# de Hostinger recibe los artefactos de las dos builds, solo cambia el nombre
# de archivo que se sube (latest.json en vez de latest.yml).

# URL completa del upload-handler.php instalado en Hostinger
UPLOAD_URL=https://logos.drilogs.com.ar/upload-handler.php

# Secreto de autenticación — debe coincidir con el UPLOAD_SECRET del PHP
UPLOAD_SECRET=COMPLETAR_con_secreto_generado_por_upload-handler
